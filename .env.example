# Browser-safe Firebase project configuration. Missing configuration enables
# a clearly labeled local demo, not a bypass of server authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Development-only opt-in for local synthetic Firebase emulator tests.
VITE_USE_FIREBASE_EMULATORS=false

# SERVER ONLY. Never prefix these with VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
