# Browser-safe Firebase project configuration. Missing configuration enables
# a clearly labeled demo, not a bypass of server authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Development-only opt-in for local synthetic Firebase emulator tests.
VITE_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# SERVER ONLY. Never prefix these with VITE_. They must never reach the browser.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI provider: nemotron | gemini | rules. Leave empty to use the first provider
# with a key (Nemotron, then Gemini), or the rule engine alone if neither is set.
AI_PROVIDER=

# NVIDIA Nemotron through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Google Gemini (Generative Language API). Set GEMINI_MODEL to a current model name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated emails allowed to run model benchmarks on a deployed server.
# Empty means benchmarking is available only on a local development server.
BENCHMARK_ALLOWED_EMAILS=
