{
  "name": "t-secure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node scripts/patch-jwks-rsa.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/patch-jwks-rsa.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "test:rules": "node --test tests/rules/*.test.js",
    "test:auth": "playwright test --config playwright.auth.config.js",
    "test:a11y": "node scripts/audit-ui.mjs",
    "capture": "node scripts/capture.mjs",
    "test:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "rimraf": "^6.1.4",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "vite": "^8.3.6"
  }
}
